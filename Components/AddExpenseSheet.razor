@* Usage from Home.razor (placed at page root, after other content, so it renders on top):
   <AddExpenseSheet @bind-IsOpen="ShowAddExpense" Category="SelectedCategory" OnSaved="LoadAsync" />
*@
@inject Gasta.Data.Repositories.IExpenseRepository ExpenseRepository
@inject Gasta.Data.Repositories.IPaymentMethodRepository PaymentMethodRepository
@inject IJSRuntime JS

<div class="sheet-scrim @(IsOpen ? "open" : "")" @onclick="Cancel"></div>
<div class="sheet-panel @(IsOpen ? "open" : "")" @onclick:stopPropagation="true">

    @if (Category is not null)
    {
        <div class="sheet-banner">
            <span class="banner-title">ADD @Category.Name.ToUpper() EXPENSE</span>
            <button class="close-btn" @onclick="Cancel">&#10005;</button>
        </div>

        <div class="sheet-body"> 
            <label class="field-label">Date</label>
            <div class="date-field-wrap">
                <div class="field-input tappable">
                    <span>@Date.ToString("MMMM d, yyyy")</span>
                    <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                        <rect x="3" y="5" width="18" height="16" rx="2" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                        <line x1="8" y1="3" x2="8" y2="7" />
                        <line x1="16" y1="3" x2="16" y2="7" />
                    </svg>
                </div>
                <input type="date" class="overlay-date-input"
                       value="@Date.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" />
            </div>

            <label class="field-label">Expense</label>
            <div class="field-input tappable" @onclick="() => ShowKeypad = true">
                @if (Amount <= 0)
                {
                    <span class="placeholder-text">Tap to enter amount</span>
                }
                else
                {
                    <span>@Amount.ToString("₱#,##0.00")</span>
                }
                <span class="chevron">&#10095;</span>
            </div>

            <label class="field-label">Payment Method</label>
            <div class="chip-wrap">
                @foreach (var m in PaymentMethods)
                {
                    <div class="pm-chip @(SelectedPaymentMethodId == m.Id ? "selected" : "")"
                         @onclick="() => SelectedPaymentMethodId = m.Id">
                        <PaymentMethodIcon LogoImage="@m.LogoImage" Name="@m.Name" ColorKey="@m.ColorKey" ShowLabelWithFallback="true" ShowBackground="false" Size="16" />
                        @if (SelectedPaymentMethodId == m.Id)
                        {
                            <span class="check-badge">&#10003;</span>
                        }
                    </div>
                }
            </div>

            <div class="remaining-row">
                <span class="remaining-label">Remaining Budget (@Category.Name)</span>
                <span class="remaining-amount @(RemainingBudget < 0 ? "danger-text" : "")">
                    @RemainingBudget.ToString("₱#,##0.00")
                </span>
            </div>

            <label class="field-label">Notes</label>
            <textarea class="field-input notes" @bind="Notes" placeholder="Add a note"></textarea>

            <div class="action-row">
                <button class="cancel-button" @onclick="Cancel">Cancel</button>
                <button class="save-button" disabled="@(!CanSave)" @onclick="Save">Add Expense</button>
            </div>
        </div>
    }
</div>

<NumericKeypad @bind-IsOpen="ShowKeypad" InitialValue="Amount" OnConfirmed="v => Amount = v" />

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Gasta.Services.SpendSummary? Category { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _wasOpen;
    private bool ShowKeypad;
    private DateTime Date = DateTime.Now;
    private decimal Amount;
    private int? SelectedPaymentMethodId;
    private string Notes = "";
    private List<Gasta.Models.PaymentMethod> PaymentMethods = new();
    private ElementReference _dateInputRef;

    private bool CanSave => Amount > 0 && SelectedPaymentMethodId.HasValue && Category is not null;

    // Informational only — how much of this category's budget is left BEFORE this new
    // expense is applied (matches the figures already shown on Home's dashboard).
    // Editing the budget itself now happens exclusively on the Manage Budget page.
    private decimal RemainingBudget => (Category?.Budget ?? 0) - (Category?.Spent ?? 0);

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen)
        {
            // Fresh entry every time the sheet opens, same as MAUI's per-open ViewModel.
            Date = DateTime.Now;
            Amount = 0;
            SelectedPaymentMethodId = null;
            Notes = "";
            ShowKeypad = false;

            if (PaymentMethods.Count == 0)
            {
                PaymentMethods = await PaymentMethodRepository.GetActiveOrderedAsync();
            }
        }
        _wasOpen = IsOpen;
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
            Date = d;
    } 

    private async Task Save()
    {
        if (!CanSave || Category is null) return;

        var expense = new Gasta.Models.Expense
        {
            Date = Date,
            Amount = Amount,
            CategoryId = Category.Id,
            PaymentMethodId = SelectedPaymentMethodId!.Value,
            Notes = string.IsNullOrWhiteSpace(Notes) ? null : Notes
        };
        await ExpenseRepository.SaveAsync(expense);

        await OnSaved.InvokeAsync();
        await Close();
    }

    private async Task Cancel() => await Close();

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }
}

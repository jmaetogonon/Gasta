@page "/stats"
@using Gasta.Components
@inject Gasta.Services.ExpenseSummaryService SummaryService
@inject Gasta.Data.Repositories.IExpenseRepository ExpenseRepository
@inject Gasta.Services.AlertService Alert
@inject NavigationManager Nav

<div class="header">
    <span class="screen-title">STATISTICS</span>
</div>

<div class="card total-spent-card">
    <span class="screen-title">TOTAL SPENT THIS MONTH</span>
    <div class="amount-row">
        <span class="amount-display">@Comparison.Current.ToString("₱#,##0.00")</span>
        @if (Comparison.Previous > 0)
        {
            <span class="compare-badge @(Comparison.IsIncrease ? "increase" : "decrease")">
                @(Comparison.IsIncrease ? "▲" : "▼") @Comparison.PercentChange.ToString("0.#")%
            </span>
        }
    </div>
    <span class="caption">vs @Comparison.Previous.ToString("₱#,##0.00") last month</span>
</div>

<div class="section-title">Last 7 Days</div>
<div class="bar-chart">
    @foreach (var point in DailySpend)
    {
        var isToday = point.Date == DateTime.Today;
        var heightPct = MaxDay <= 0 ? 0 : (double)(point.Amount / MaxDay) * 100;
        <div class="bar-column">
            <span class="bar-amount">@(point.Amount > 0 ? point.Amount.ToString("₱#,##0") : "")</span>
            <div class="bar-track">
                <div class="bar-fill @(isToday ? "today" : "")" style="height:@(heightPct)%;"></div>
            </div>
            <span class="bar-label @(isToday ? "today-label" : "")">@(isToday ? "Today" : point.Date.ToString("ddd"))</span>
        </div>
    }
</div>

<div class="section-header">
    <span class="section-title">Recent Transactions</span>
    <span class="see-all" @onclick="GoToAllTransactions">See All</span>
</div>

<div class="transaction-list">
    @if (RecentTransactions.Count == 0)
    {
        <div class="empty-state">No transactions yet.</div>
    }
    @foreach (var item in RecentTransactions)
    {
        <div class="transaction-row-wrap">
            <div class="delete-action" @onclick="() => DeleteExpense(item.Id)">🗑 Delete</div>

            <div class="transaction-row"
                 style="transform:translateX(@(GetOffset(item.Id).ToString(System.Globalization.CultureInfo.InvariantCulture))px);"
                 @onpointerdown="e => OnPointerDown(e, item.Id)"
                 @onpointermove="OnPointerMove"
                 @onpointerup="e => OnPointerUp(item)"
                 @onpointercancel="OnPointerCancel">
                <div class="tx-icon" style="background:@item.CategoryColorKey;">
                    <img src="images/categories/@(item.CategoryLogo).png" />
                </div>
                <div class="tx-info">
                    <span class="tx-category">@item.CategoryName</span>
                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                    {
                        <span class="tx-notes">@item.Notes</span>
                    }
                    <span class="tx-date">@item.Date.ToString("MMM d")</span>
                </div>
                <strong class="tx-amount">@item.Amount.ToString("₱#,##0.00")</strong>
            </div>
        </div>
    }
</div>

<EditExpenseSheet @bind-IsOpen="ShowEdit" ExpenseId="EditingExpenseId" OnSaved="LoadAsync" />

@code {
    private Gasta.Services.MonthComparison Comparison = new(0, 0);
    private List<Gasta.Services.DailySpendPoint> DailySpend = new();
    private List<Gasta.Services.ExpenseListItem> RecentTransactions = new();

    private decimal MaxDay => DailySpend.Count == 0 ? 0 : DailySpend.Max(d => d.Amount);

    // --- Swipe-to-reveal-delete state, same pattern as ExpenseListPage. Intentionally
    // duplicated rather than extracted, matching the project's documented decision to
    // defer that refactor and avoid destabilizing working pages mid-build. ---
    private readonly Dictionary<int, double> _offsets = new();
    private int? _draggingId;
    private double _startX;
    private double _startOffset;
    private bool _dragMoved;
    private const double RevealOffset = -84;
    private const double DragThreshold = 8;
    private const double SnapThreshold = 40;

    private bool ShowEdit;
    private int EditingExpenseId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var now = DateTime.Now;
        Comparison = await SummaryService.GetMonthOverMonthAsync(now.Year, now.Month);
        DailySpend = await SummaryService.GetLast7DaysAsync();
        RecentTransactions = await SummaryService.GetRecentTransactionsAsync(5);
    }

    private double GetOffset(int id) => _offsets.TryGetValue(id, out var v) ? v : 0;

    private void OnPointerDown(PointerEventArgs e, int id)
    {
        _draggingId = id;
        _startX = e.ClientX;
        _startOffset = GetOffset(id);
        _dragMoved = false;
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (_draggingId is not int id) return;
        var dx = e.ClientX - _startX;
        if (Math.Abs(dx) > DragThreshold) _dragMoved = true;
        _offsets[id] = Math.Clamp(_startOffset + dx, RevealOffset, 0);
    }

    private void OnPointerUp(Gasta.Services.ExpenseListItem item)
    {
        if (_draggingId != item.Id) { _draggingId = null; return; }

        var id = item.Id;
        var offset = GetOffset(id);

        if (!_dragMoved)
        {
            if (offset < -1)
            {
                _offsets[id] = 0;
            }
            else
            {
                EditingExpenseId = item.Id;
                ShowEdit = true;
            }
        }
        else
        {
            _offsets[id] = offset < -SnapThreshold ? RevealOffset : 0;
        }

        _draggingId = null;
    }

    private void OnPointerCancel()
    {
        if (_draggingId is int id) _offsets[id] = _startOffset;
        _draggingId = null;
    }

    private async Task DeleteExpense(int expenseId)
    {
        var confirmed = await Alert.ShowConfirmAsync("Delete this transaction?", "Confirm Delete");
        if (!confirmed) return;

        await ExpenseRepository.DeleteAsync(expenseId);
        _offsets.Remove(expenseId);
        await LoadAsync();
    }

    private void GoToAllTransactions() => Nav.NavigateTo("/alltransactions");
}

@page "/settings"
@inject Gasta.Services.ThemeService ThemeService
@inject Gasta.Data.IndexedDbService IndexedDbService
@inject Gasta.Services.SeedService SeedService
@inject Gasta.Services.UserProfileService UserProfile
@inject Gasta.Services.AlertService Alert
@inject NavigationManager Nav

<PageTitle>Gasta - Settings</PageTitle>
 
<div class="header-content">
            <div class="header-content-left">
                <span class="header-title">Settings</span> 
                <span class="intro-text">
                    Settings muna bago gastos. Para kahit papaano, may plano ang kagastusan mo.
                    @* Settings muna bago gastos. Para may plano naman.  *@
                </span>
            </div>
            <img src="images/mascot-settings.gif" />
        </div>

<div class="section">
    <span class="section-label">Profile</span>
    <div class="list-card nickname-card">
        <div class="nickname-row"> 
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person-fill" viewBox="0 0 16 16">
  <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
</svg>
            <input class="nickname-input" @bind="Nickname" @bind:event="oninput" placeholder="Your name" maxlength="20" />
            <button class="save-nickname-btn" hidden="@(!NicknameChanged)" @onclick="SaveNickname">Save</button>
        </div>
    </div>
    @if (NicknameSaved)
    {
        <div class="inline-note success-note">Saved!</div>
    }
</div>

<div class="section">
    <span class="section-label">Appearance</span>
    <div class="segmented">
        <button class="segment @(CurrentTheme == "Light" ? "active" : "")" @onclick='() => SetTheme("Light")'>
            ☀️ Light
        </button>
        <button class="segment @(CurrentTheme == "Dark" ? "active" : "")" @onclick='() => SetTheme("Dark")'>
            🌙 Dark
        </button>
    </div>
</div>

<div class="section">
    <span class="section-label">Manage</span>
    <div class="list-card">
        <div class="list-row" @onclick='() => Nav.NavigateTo("managepaymentmethods")'>
            <span>Manage Payment Methods</span>
            <span class="chevron">&#10095;</span>
        </div>
        <div class="list-row" @onclick='() => Nav.NavigateTo("managecategories")'>
            <span>Manage Categories</span>
            <span class="chevron">&#10095;</span>
        </div>
    </div>
</div>

<div class="section">
    <span class="section-label">Notifications</span>
    <div class="list-card">
        <div class="list-row toggle-row">
            <span>Budget Reminders</span>
            <label class="switch">
                <input type="checkbox" @bind="BudgetReminders" @bind:after="OnReminderToggled" />
                <span class="slider"></span>
            </label>
        </div>
    </div>
  @*<div class="inline-note">Reminder preference is saved, but no notifications are sent yet.</div>*@  
</div>

<div class="section">
    <span class="section-label">Data</span>
    <button class="danger-button" @onclick="DoReset">Reset All Data</button>
    @if (ResetDone)
    {
        <div class="inline-note success-note">Data reset. Reloading...</div>
    }
</div>

<div class="about-footer">
    GASTA v1.0.0
</div>

@code {
    private const string RemindersKey = "gasta-budget-reminders";

    private string CurrentTheme = "Light";
    private bool BudgetReminders;
    private bool ResetDone;

    private string Nickname = "";
    private string _originalNickname = "";
    private bool NicknameSaved;
    private bool NicknameChanged =>
        !string.IsNullOrWhiteSpace(Nickname) && Nickname.Trim() != _originalNickname;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        CurrentTheme = await ThemeService.GetCurrentAsync();
        var saved = await JS.InvokeAsync<string?>("localStorage.getItem", RemindersKey);
        BudgetReminders = saved == "true";

        Nickname = _originalNickname = await UserProfile.GetNicknameAsync();
    }

    private async Task SetTheme(string option)
    {
        CurrentTheme = option;
        await ThemeService.ApplyAsync(option);
    }

    private async Task OnReminderToggled()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", RemindersKey, BudgetReminders ? "true" : "false");
    }

    private async Task SaveNickname()
    {
        var trimmed = Nickname.Trim();
        await UserProfile.SetNicknameAsync(trimmed);
        _originalNickname = trimmed;
        NicknameSaved = true;
        StateHasChanged();
        await Task.Delay(1500);
        NicknameSaved = false;
        StateHasChanged();
    }

    private async Task ShowComingSoon(string feature)
    {
        await Alert.ShowAsync($"{feature} is coming soon.", "Coming Soon");
    }

    private async Task DoReset()
    {
        var confirmed = await Alert.ShowConfirmAsync(
            "This will erase everything, including your name, and start fresh. Are you sure?",
            "Reset All Data",
            confirmText: "Reset",
            cancelText: "Cancel");

        if (!confirmed) return;

        await IndexedDbService.ClearAllAsync();
        await SeedService.SeedIfEmptyAsync();

        // Fresh start entirely — not just the database. Clearing profile means
        // MainLayout's onboarding check fails again on next launch, so the person
        // walks through onboarding (including picking a new nickname) instead of
        // landing on an empty Home still showing their old name.
        await UserProfile.ClearProfileAsync();

        ResetDone = true;
        StateHasChanged();
        await Task.Delay(1200);
        await JS.InvokeVoidAsync("location.reload");
    }
}
@page "/onboarding"
@layout Gasta.Layout.OnboardingLayout
@inject Gasta.Services.UserProfileService UserProfile
@inject Gasta.Services.ThemeService ThemeService
@inject NavigationManager Nav

<div class="onboarding-page">
    <div class="theme-toggle-row">
        <button class="theme-toggle-btn" @onclick="ToggleTheme" aria-label="Toggle theme">
            @(CurrentTheme == "Dark" ? "☀️" : "🌙")
        </button>
    </div>

    @if (Step == WelcomeStep)
    {
        <div class="welcome-step">
            <div class="icon-outer @(CurrentTheme == "Dark" ? "dark" : "")">
                <div class="icon-crop">
                    <img src="images/gasta-icon.gif" class="app-icon-gif" alt="Gasta" />
                </div>
            </div>
            <span class="welcome-title">Welcome to Gasta</span>
            <span class="welcome-body">
                Track every peso, set smart budgets, and see exactly where your
                money goes — right from your phone.
            </span>

            <button class="get-started-button" @onclick="() => Step = 1">Get Started</button>

            <div class="hints-list">
                <span class="hint-row">📶 Works fully offline</span>
                <span class="hint-row">🔒 Your data stays on this device</span>
             </div>
        </div>
    }
    else if (Step <= SlideCount)
    {
        var slideIndex = Step - 1;
        <div class="slide-content">
            <div class="slide-icon">
                 <img src="@SlidePng[slideIndex]" class="slide-image" style="height: @(SlidePngHeight[slideIndex]);" />
            </div>
            <span class="slide-title">@SlideTitles[slideIndex]</span>
            <span class="slide-body">@SlideBodies[slideIndex]</span>
        </div>

        <div class="dots-row">
            @for (var i = 0; i < SlideCount; i++)
            {
                var idx = i;
                <span class="dot @(slideIndex == idx ? "active" : "")"></span>
            }
        </div>

        <div class="nav-row">
            <button class="back-button" @onclick="PrevStep">Back</button>
            <button class="next-button" @onclick="NextStep">
                @(Step == SlideCount ? "Continue" : "Next")
            </button>
        </div>
    }
    else
    {
        <div class="name-step">
            <div class="slide-icon">
                 <img src="images/gasta-onboard4.png" class="slide-image" style="height:170px;"/>
            </div>
            <span class="name-title">What should we call you?</span>
            <span class="name-subtitle">This shows up on your home screen.</span>

            <input class="name-input" @bind="Nickname" @bind:event="oninput"
                   placeholder="e.g. Juan" maxlength="20" />

            <button class="get-started-button" @onclick="Finish" disabled="@(string.IsNullOrEmpty(Nickname))">Let's G!</button>
        </div>

        <div class="nav-row">
            <button class="back-button" @onclick="PrevStep">Back</button> 
         </div>
    }
</div>

@code {
    private const int WelcomeStep = 0;
    private const int SlideCount = 3;
    private const int NameStep = SlideCount + 1;

    private int Step = WelcomeStep;
    private string Nickname = "";
    private string CurrentTheme = "Light";

    private static readonly string[] SlideTitles =
    {
        "Track Every Peso",
        "Set Smart Budgets",
        "See the Big Picture"
    };

    private static readonly string[] SlideBodies =
    {
        "Log expenses in seconds — organized by category and payment method.",
        "Set a monthly budget and watch your progress update in real time.",
        "Get clear insights into your spending trends, all in one place."
    };

    private static readonly string[] SlidePng =
    {
        "images/gasta-onboard1.png", 
        "images/gasta-onboard2.png", 
        "images/gasta-onboard3.png", 
    };

    private static readonly string[] SlidePngHeight =
    {
        "185px", 
        "140px", 
        "185px", 
    };

    private static readonly string[] SlideIcons =
    {
        """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="88" height="88"><path d="M3 7a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M16 12h3v3h-3a1.5 1.5 0 0 1 0-3Z"/></svg>""",
        """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="88" height="88"><circle cx="12" cy="12" r="9"/><path d="M12 3v9l6.36 6.36"/></svg>""",
        """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="88" height="88"><line x1="6" y1="20" x2="6" y2="12"/><line x1="12" y1="20" x2="12" y2="6"/><line x1="18" y1="20" x2="18" y2="15"/></svg>"""
    };

    protected override async Task OnInitializedAsync()
    {
        CurrentTheme = await ThemeService.GetCurrentAsync();
    }

    private async Task ToggleTheme()
    {
        CurrentTheme = CurrentTheme == "Dark" ? "Light" : "Dark";
        await ThemeService.ApplyAsync(CurrentTheme);
    }

    private void NextStep()
    {
        if (Step < SlideCount) Step++;
        else Step = NameStep;
    }

    private void PrevStep()
    {
        if (Step > 1) Step--;
        else Step = WelcomeStep;
    }

    private async Task Finish()
    {
        if (!string.IsNullOrWhiteSpace(Nickname))
            await UserProfile.SetNicknameAsync(Nickname);

        await UserProfile.MarkOnboardedAsync();
        Nav.NavigateTo("", forceLoad: false);
    }
}